generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("VIEWER") // ADMIN ANALYST VIEWER
  name      String
  createdAt DateTime @default(now())
}

model Transaction {
  id        String   @id @default(cuid())
  amount    Float
  category  String   // PAYMENT TRANSFER CRYPTO FX
  status    String   // SUCCESS PENDING FAILED FLAGGED
  riskScore Float
  merchant  String
  country   String
  createdAt DateTime @default(now())
}
